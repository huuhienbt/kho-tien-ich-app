{
  "name": "egv-nhom-hoc",
  "version": "1.0.0",
  "description": "Private group attendance, tuition and files on Cloudflare Workers + D1 + R2",
  "scripts": {
    "engine": "node scripts/build-engine.mjs",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "check": "node scripts/build-engine.mjs --check && tsc --noEmit && wrangler deploy --dry-run --env= --outdir dist",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy --env=",
    "deploy:r2": "wrangler deploy --env r2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "miniflare": "^5.20261006.1-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "private": true
}
